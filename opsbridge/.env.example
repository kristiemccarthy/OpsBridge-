# =========================================================
# OpsBridge — Environment Variables
# =========================================================
# HOW TO USE:
# 1. Copy this file and rename the copy to ".env"
# 2. Fill in your real values in the .env file
# 3. NEVER commit your .env file to git (it's already in .gitignore)
# =========================================================

# --- Supabase (get from: supabase.com → your project → Settings → API) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Google Translate API (get from: console.cloud.google.com) ---
# This key is used by the BACKEND only — never put it in the frontend
GOOGLE_TRANSLATE_API_KEY=your-google-api-key-here

# --- Backend server port ---
PORT=3001
